# ==============================================================================
# TradingHive Autonomous Production & Paper Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Broker & Market Data API Credentials (Alpaca)
# ------------------------------------------------------------------------------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_NEWS_URL=https://data.alpaca.markets
# For paper trading: https://paper-api.alpaca.markets
# For live real-money execution: https://api.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_STOCKS_FEED=iex
# Optional options feed: indicative / opra
# ALPACA_OPTIONS_FEED=indicative

# ------------------------------------------------------------------------------
# 2. Operating Mode & Safety Confirmation
# ------------------------------------------------------------------------------
# Set to YES only when ready to execute live real-money orders
TRADING_HIVE_LIVE_CONFIRM=NO

# ------------------------------------------------------------------------------
# 3. Storage & Persistence
# ------------------------------------------------------------------------------
TRADING_HIVE_DB=trading_hive.sqlite
TRADING_HIVE_HISTORY_DIR=data
TRADING_HIVE_CONFIG_VERSION=production-v1

# ------------------------------------------------------------------------------
# 4. Market Clock & Session Timings
# ------------------------------------------------------------------------------
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00

# ------------------------------------------------------------------------------
# 5. Autonomous Universe Discovery (Alpaca Screener)
# ------------------------------------------------------------------------------
# Maximum candidates queried from Alpaca screener (1..99)
HIVE_DISCOVERY_LIMIT=99
# Maximum liquid symbols selected into the active trading universe
HIVE_MAX_UNIVERSE_SIZE=10

# ------------------------------------------------------------------------------
# 6. Portfolio Allocation & Hive Manufacturing Sizing
# ------------------------------------------------------------------------------
# Total nominal capital allocated across active bot fleet
HIVE_TOTAL_CAPITAL=1000000
# Maximum concurrent bots across the entire system
HIVE_MAX_BOTS=20
# Maximum concurrent bots allocated to a single symbol
HIVE_MAX_BOTS_PER_SYMBOL=4
# Maximum portfolio capital fraction allocated to a single symbol (0.25 = 25%)
HIVE_MAX_SYMBOL_CAPITAL_PCT=0.25
# Fraction of total capital allocated per bot execution
HIVE_RISK_FRACTION=0.05
# Maximum holding duration in minutes before mandatory time exit
BOT_MAX_HOLD_MINUTES=180
# Target stop-loss and take-profit percentages
TRADING_STOP_LOSS_PCT=0.05
TRADING_TAKE_PROFIT_PCT=0.0

# ------------------------------------------------------------------------------
# 7. System Safety Limits (Enforced by Deterministic RiskGovernor)
# ------------------------------------------------------------------------------
RISK_MAX_ORDER_NOTIONAL=1000.0
RISK_MAX_TOTAL_NOTIONAL=5000.0
RISK_MAX_DAILY_LOSS=250.0
RISK_MAX_POSITIONS=10
RISK_MAX_SINGLE_POSITION_QTY=10
RISK_MAX_SPREAD_BPS=250.0
RISK_MAX_SYMBOL_EXPOSURE=1500.0
RISK_MAX_TRADE_RISK_PCT=0.01
RISK_MAX_PORTFOLIO_RISK_PCT=0.05
RISK_SIZING_CEILING_ACTION=CAP

# ------------------------------------------------------------------------------
# 8. Options Expiry Constraints
# ------------------------------------------------------------------------------
MIN_EXPIRY_MINUTES=30
MAX_EXPIRY_MINUTES=360
